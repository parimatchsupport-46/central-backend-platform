# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/central_backend

# Security & JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_local_env
JWT_EXPIRES_IN=7d

# Default Super Admin (used only for initial seed)
ADMIN_EMAIL=admin@centralbackend.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Super Admin

# Storage Configuration ('local' for dev, 's3' for production)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
LOCAL_BACKUP_PATH=./backups
MAX_FILE_SIZE_MB=10
